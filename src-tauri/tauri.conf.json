{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Zentr",
	"version": "0.1.0",
	"identifier": "com.zentr.app",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist",
		"features": []
	},
	"app": {
		"security": {
			"csp": null,
			"capabilities": []
		},
		"windows": [
			{
				"title": "Zentr",
				"label": "main",
				"fullscreen": true,
				"focusable": true,
				"focus": true,
				"decorations": false,
				"backgroundColor": "#18181B"
			}
		],
		"withGlobalTauri": true
	},
	"bundle": {
		"active": true,
		"publisher": "Zentr Project",
		"copyright": "© Zentr Project",
		"category": "Utility",
		"longDescription": "Zentr",
		"shortDescription": "Zentr is a native Windows app for unified homelab monitoring, control, and automation.",
		"license": "MIT",
		"targets": [
			"msi"
		],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"allowDowngrades": false,
			"certificateThumbprint": null,
			"digestAlgorithm": null,
			"nsis": null,
			"signCommand": null,
			"timestampUrl": null,
			"tsp": false,
			"webviewInstallMode": {
				"silent": true,
				"type": "downloadBootstrapper"
			},
			"wix": {
				"language": "en-US"
			}
		},
		"resources": []
	}
}